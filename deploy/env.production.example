# /srv/gist/.env on the server. Never commit the filled-in copy.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
TWELVELABS_API_KEY=tlk_your_key_here

GIST_CORS_ORIGINS=https://gist.usesky.io
GIST_COOKIE_DOMAIN=gist.usesky.io
GIST_COOKIE_SECURE=1

# CPU transcription on a small server: keep demo videos short.
GIST_DEMO_MAX_DURATION_SECONDS=1800
GIST_MAX_CONCURRENT_INGESTIONS=1
