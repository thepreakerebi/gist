# Gist API configuration. Copy to `.env` (gitignored) and fill in.
# The API loads this at startup via python-dotenv; real environment variables
# take precedence over anything set here.

# Enables the OpenAI answerer in the live demo (gpt-4.1-mini). Optional.
OPENAI_API_KEY=

# Enables the Claude answerer in the live demo. Optional.
ANTHROPIC_API_KEY=

# Comma-separated frontend origins allowed to call the API with the session
# cookie. Defaults to http://localhost:3000. "*" is refused. See docs/security.md.
# GIST_CORS_ORIGINS=https://gist.example.com

# Share the session cookie with the frontend's own server (deployment only).
# GIST_COOKIE_DOMAIN=gist.example.com
# Force the Secure flag; by default it is set whenever the request is HTTPS.
# GIST_COOKIE_SECURE=1

# Questions per access code per day (admin codes are exempt). Default 5.
# GIST_DAILY_QUESTION_CAP=5
# Video ingestions allowed to run at once across all codes. Default 2.
# GIST_MAX_CONCURRENT_INGESTIONS=2

# Mount the research endpoints that read paths on the server's disk
# (/v1/ingestions, /v1/local-video-compressions, /v1/compressions, /v1/demo/run).
# Local experiments only; never in a deployment.
# GIST_ENABLE_RESEARCH_ROUTES=1

# Max video length (seconds) the live demo will accept. Default 1800 (30 min).
# Larger clips mean slow CPU-Whisper runs; lower it for snappier demos.
# GIST_DEMO_MAX_DURATION_SECONDS=1800
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
TWELVELABS_API_KEY=tlk_your_key_here
